    .section ".startup", "ax"
    .align  2
    .globl  __boot
__boot:
    -- initialize register
    mov    r0, r1
    mov    r0, r2
    mov    r0, r3
    mov    r0, r4
    mov    r0, r5
    mov    r0, r6
    mov    r0, r7
    mov    r0, r8
    mov    r0, r9
    mov    r0, r10
    mov    r0, r11
    mov    r0, r12
    mov    r0, r13
    mov    r0, r14
    mov    r0, r15
    mov    r0, r16
    mov    r0, r17
    mov    r0, r18
    mov    r0, r19
    mov    r0, r20
    mov    r0, r21
    mov    r0, r22
    mov    r0, r23
    mov    r0, r24
    mov    r0, r25
    mov    r0, r26
    mov    r0, r27
    mov    r0, r28
    mov    r0, r29
    mov    r0, r30
    mov    r0, r31
    ldsr    r0, 0, 0    --  EIPC
    ldsr    r0, 16, 0   --  CTPC
    
    -- jump to entry point of each PE
    stsr    0, r10, 2   -- get PEID
    
    cmp    0, r10
    bz    .L.entry_PE0
    cmp    1, r10
    bz    .L.entry_PE1
    cmp    2, r10
    bz    .L.entry_PE2
    cmp    3, r10
    bz    .L.entry_PE3
    cmp    4, r10
    bz    .L.entry_PE4
    cmp    5, r10
    bz    .L.entry_PE5
    cmp    6, r10
    bz    .L.entry_PE6
    cmp    7, r10
    bz    .L.entry_PE7
__exit:
    br    __exit
    
.L.entry_PE0:
    jarl    _hdwinit_PE0, lp    -- initialize hardware
    jr32    __cstart_pe0        -- not return from __cstart_pm0
    br    __exit
    
.L.entry_PE1:
    jarl    _hdwinit_PE1, lp    -- initialize hardware
    jr32    __cstart_pe1        -- not return from __cstart_pm1
    br    __exit
    
.L.entry_PE2:
    br    __exit
.L.entry_PE3:
    br    __exit
.L.entry_PE4:
    br    __exit
.L.entry_PE5:
    br    __exit
.L.entry_PE6:
    br    __exit
.L.entry_PE7:
    br    __exit
    
--------------------------------------------------------------------------------
--    hdwinit_PE0
--------------------------------------------------------------------------------
    .align    2
_hdwinit_PE0:
    mov    lp, r29      -- save return address
    
    -- clear Global RAM
    mov    __ghs_cluster_ram_start, r6
    mov    __ghs_cluster_ram_end, r7
    jarl    _zeroclr4, lp
    
    -- clear Local RAM PE0
    mov    __ghs_local_ram_cpu0_start, r6
    mov    __ghs_local_ram_cpu0_end, r7
    jarl    _zeroclr4, lp
    
    mov    r29, lp
    jmp    [lp]
    
--------------------------------------------------------------------------------
--    hdwinit_PE1
--------------------------------------------------------------------------------
    .align    2
_hdwinit_PE1:
    mov    lp, r14      -- save return address
    
    -- clear Local RAM PE1
    mov    __ghs_local_ram_cpu1_start, r6
    mov    __ghs_local_ram_cpu1_end, r7
    jarl    _zeroclr4, lp
    
    mov    r14, lp
    jmp    [lp]
    
--------------------------------------------------------------------------------
--    zeroclr4
--------------------------------------------------------------------------------
    .align    2
_zeroclr4:
    br    .L.zeroclr4.2
.L.zeroclr4.1:
    st.w    r0, 0[r6]
    add    4, r6
.L.zeroclr4.2:
    cmp    r6, r7
    bh    .L.zeroclr4.1
    jmp    [lp]

