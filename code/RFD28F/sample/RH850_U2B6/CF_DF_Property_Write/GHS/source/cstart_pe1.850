-- /*******************************************************************************************************************
--  *   start up (PE1)
--  ******************************************************************************************************************/
    
    .section ".startup", "ax"
    .global __cstart_pe1
    .align  2
__cstart_pe1:
    mov    ___ghsend_stack, sp  -- Set sp register
    
    mov    ___ghsbinfo_copy, r6
    mov    ___ghseinfo_copy, r7
    mov    ___ghsbinfo_clear, r8
    mov    ___ghseinfo_clear, r9
    
    jarl32  _initsct, lp        --  Initialize RAM area
    
    -- Set various flags to PSW via FEPSW
    stsr    5, r10, 0           -- r10 <- PSW
    
    movhi   0x0001, r0, r11
    or      r11, r10
    ldsr    r10, 5, 0           -- Enable FPU
    
--  When FPU is used, remove the comment as follows
--    movhi   0x0002, r0, r11
--    ldsr    r11, 6, 0           -- Initialize FPSR
--    ldsr    r0, 7, 0            -- Initialize FPEPC
    
    ldsr    r10, 3, 0           -- FEPSW <- r10
    
    -- If you specify the -sda=all or -sda=<size>, please enable
    mov    __gp, r4           -- r4 <- __gp    
    mov    __tp, r5           -- r5 <- __tp
    
    mov     _exit, lp           -- lp <- _exit
    mov     _main_pe1, r10
    ldsr    r10, 2, 0           -- FEPC <- _main_pe2
    
    -- Apply PSW and PC to start user mode
    feret
    
_exit:
    br      _exit               -- end of program
    
