-------------------------------------------------------------------------------
-------------  Selection of external interrupt service handler
-------------  User modifiable section
-------------  Please uncomment the required interrupt service handler
-------------------------------------------------------------------------------
#include <Startup.inc>

-------------------------------------------------------------------------------
-------------  Basic Initialisation of the controller
-------------  User modifiable section
-------------------------------------------------------------------------------
  .extern __unused_isr
  .extern _SYNC_PE0
  .extern _exit
  .set    CUx_EBV, 0x00038000
  .text
-------------------------------------------------------------------------------
-------------  PEn Specific Startup Routine
-------------------------------------------------------------------------------
  .global _RESET_PEn
_RESET_PEn:
  -- Waiting CPU0 startup
  jarl  _SYNC_PE0, lp

  -- Initialization of the global pointer
  mov   __gp, gp
  -- Initialization of the text pointer
  mov   __tp, r5

  -- then set 1 to PSW.EBV -> RBASE!=EBASE
  -- then set 1 to PSW.CU0 and CU1
  stsr  PSW, r10, 0
  mov   CUx_EBV, r11
  or    r11, r10
  ldsr  r10, PSW, 0


#if defined (PE1_USED)
  jmpIfPEn  _INIT_PE1, PE1
#endif
#if defined (PE2_USED)
  jmpIfPEn  _INIT_PE2, PE2
#endif
#if defined (PE3_USED)
  jmpIfPEn  _INIT_PE3, PE3
#endif
#if defined (PE4_USED)
  jmpIfPEn  _INIT_PE4, PE4
#endif
#if defined (PE5_USED)
  jmpIfPEn  _INIT_PE5, PE5
#endif
#if defined (PE6_USED)
  jmpIfPEn  _INIT_PE6, PE6
#endif

_loop:
  br    _loop

-------------------------------------------------------------------------------
-------------  Init LRAM 1
#if defined (PE1_USED)
-------------------------------------------------------------------------------
_Init_LRAM1:
  mov         0xAAAAAAAA, r6
  mov   ___ghs_ram1start, r7
  mov     ___ghs_ram1end, r8

_ram_loop1:
  cmp                 r7, r8
  bne   2f
  1: jmp   [lp]
  2: st.w             r6, 0[r7]
     add               4, r7
     br               _ram_loop1
#endif

-------------------------------------------------------------------------------
-------------  Init LRAM 2
#if defined (PE2_USED)
-------------------------------------------------------------------------------
_Init_LRAM2:
