  mov   ___ghsend_stack1_PE6, sp

  -- Initialization of the interrupt base pointer
  --mov   ___ghsbegin_inttable_PE6, r1
  mov   0x0000A600, r1
  
  ldsr  r1, INTBP, 1

  -- First set EBASE register address
  --mov   __ex_entry_PE6 r11
  ldsr  r11, EBASE, 1

  -- Jump to  main_PE5()
  jarl  _main_PE6, lp
  mov   r10, r6
  jarl  _exit, lp
#endif

