-------------------------------------------------------------------------------
-------------  PE1 Specific Startup Routine
-------------------------------------------------------------------------------
#if defined (PE1_USED)
_INIT_PE1:
  -- Initialize Local Ram 1
  jarl  _Init_LRAM1, lp

  -- Initialization of the stack pointer
  mov   ___ghsend_stack1_PE1, sp

  -- Initialization of the interrupt base pointer
  mov   ___ghsbegin_inttable_PE1, r1
  ldsr  r1, INTBP, 1

  -- First set EBASE register address
  mov   __ex_entry_PE1, r11
  ldsr  r11, EBASE, 1

  -- Jump to  main_PE1()
  jarl  _main_PE1, lp
  mov   r10, r6
  jarl  _exit, lp
#endif

