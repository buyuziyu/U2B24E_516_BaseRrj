-------------------------------------------------------------------------------
-- Revision Control History:
-- E1.0.0g :   24th-Aug-2021    : Initial Version
-------------------------------------------------------------------------------

  .set    CUx_EBV, 0x00038000
  .text

-------------------------------------------------------------------------------
------------- This ghs liability is used for sync between other core
-------------------------------------------------------------------------------
  .global ___ghs_board_devices_init
___ghs_board_devices_init:
  -- .mev_address section in cRAM_0 is used for Sync flags
  mov     ___ghsbegin_mev_address, r20
  st.w    r0, 0[r20]
  jmp     [lp]

-------------------------------------------------------------------------------
-------------- Sync PE0 Routine
-------------------------------------------------------------------------------
  .global _SYNC_PE0
_SYNC_PE0:
      mov     ___ghsbegin_mev_address, r20
      set1    1, 0x0[r20]
Lock: ldl.w   [r20], r21
      cmp     r0, r21
      bnz     Lock_wait
      mov     1, r21
      stc.w   r21, [r20]
      cmp     r0, r21
      bnz     Lock_success
Lock_wait:
      snooze
      br      Lock
Lock_success:
      st.w    r0, 0[r20]
      jmp     [lp]

-------------------------------------------------------------------------------
-------------  PE0 Specific Startup Routine
-------------------------------------------------------------------------------
  .global _RESET_PE0
_RESET_PE0:
-------------  Memory Initialization
  -- Initialize Cluster Ram
  jarl  _Init_CRAM0, lp

  -- Initialize Local Ram 0
  jarl  _Init_LRAM0, lp


-------------  PE0 Initialization
  -- Initialization of the global pointer
  mov   ___ghsbegin_sdabase, gp

  -- Initialization of the text pointer
  mov   __tp, r5

  -- Initialization of the stack pointer
  mov   ___ghsend_stack, sp

  -- Initialization of the interrupt base pointer
  mov   ___ghsbegin_inttable_PE0, r1
  ldsr  r1, INTBP, 1

  -- First set EBASE register address
  mov   __ex_entry_PE0, r10
  ldsr  r10, EBASE, 1

  -- then set 1 to PSW.EBV -> RBASE!=EBASE
  -- then set 1 to PSW.CU0 and CU1
  stsr  PSW, r10, 0
  mov   CUx_EBV, r11
  or    r11, r10
  ldsr  r10, PSW, 0

  -- Jump to the initialisation functions of the library
  -- and from there to main()
  jr    __start

-------------------------------------------------------------------------------
-------------  Init CRAM
-------------------------------------------------------------------------------
_Init_CRAM0:
  mov          0xAAAAAAAA, r6
  mov    ___ghs_cram0start, r7
  mov      ___ghs_cram0end, r8

_cram_loop:
  cmp                  r7, r8
  bne   2f
  1: jmp   [lp]
  2: st.w              r6, 0[r7]
     add                4, r7
     br               _cram_loop

-------------------------------------------------------------------------------
-------------  Init LRAM 0
-------------------------------------------------------------------------------
_Init_LRAM0:
  mov         0xAAAAAAAA, r6
  mov    ___ghs_ramstart, r7
  mov      ___ghs_ramend, r8

_ram_loop:
  cmp                 r7, r8
  bne   2f
  1: jmp   [lp]
  2: st.w             r6, 0[r7]
     add               4, r7
     br               _ram_loop


-------------------------------------------------------------------------------
-------------  Interrupt service routine of unused interrupts
-------------------------------------------------------------------------------
  .global  __unused_isr
__unused_isr:
  br    __unused_isr

