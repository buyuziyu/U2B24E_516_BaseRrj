#include "ind_800.h"

        .file "ccmemcpy.800"
        .text
        .align  2
..lxtdaG._memcpy=:0
	.weak  _memcpy
        .globl  _memcpy
#if __ghs_asm == 2
        .globl  _memcpy_mcopy
#endif
	-- r6 is the destination pointer
	-- r7 is the source pointer
	-- r8 holds the number of bytes to copy
	-- we return r6 in r10
	-- In 20 register mode, we cannot use r15-r24
	-- _memcpy_mcopy is a private entry point to this version of memcpy
	-- which is called by _mcopy. _mcopy saves all the registers which 
	-- are used by this version of memcpy. Even if the user overrides
	-- memcpy with their own version, _mcopy will still call this version
	-- of memcpy which only modifies registers _mcopy was designed for.
___callee.memcpy.p.ppi::
	.size	___callee.memcpy.p.ppi,0
___callee.memcpy_mcopy.p.ppi::
	.size	___callee.memcpy_mcopy.p.ppi,0
_memcpy:
_memcpy_mcopy:
    	mov	r6,r1
	andi	3,r6,r11
	bnz	bytesr6
	xor	r7,r11
	andi	3,r11,r11
	bnz	bytesr7
	-- r6 and r7 are aligned
both_aligned:
	mov	r8,r14
	shr	4,r14
	bz	word_loop_setup
four_word_loop:
#ifdef __CORE_V850E3V5__
	ld.dw	0[r7],r10
	ld.dw	8[r7],r12
	add	16,r7
	st.dw	r10,0[r6]
	st.dw	r12,8[r6]
	add	16,r6
	loop	r14, four_word_loop
#else
	ld.w	0[r7],r10
	ld.w	4[r7],r11
	ld.w	8[r7],r12
	ld.w	12[r7],r13
	add	16,r7
	st.w	r10,0[r6]
	st.w	r11,4[r6]
	st.w	r12,8[r6]
	st.w	r13,12[r6]
	add	16,r6
	add	-1,r14
	bnz 	four_word_loop
#endif
	and	15,r8
word_loop_setup:
-- For the remaining bytes (up to 15), try to copy them word-by-word as much
-- as possible
        mov	r8,r14
  	shr     2,r14
        bz      bytes
word_loop:
 	ld.w	0[r7],r10
	add	4, r7
	st.w	r10,0[r6]
	add	4,r6
#if __CORE_V850E3V5__
	loop	r14, word_loop
#else
	add	-1,r14
	bnz	word_loop
#endif
	and	3, r8
	bnz	bytes
	mov	r1,r10
	jmp	[lp]
-- r6 is not aligned, try to copy the first few bytes to align it
bytesr6:
	mov	r6,r11
	mov	r8,r9
	subr	r0,r11
	and	3,r11
	-- r11 holds the number of bytes needed to align r6
	-- check that we have enough bytes to copy to align r6
	sub	r11,r9
	bnh	bytes
.align 4
	-- loop aligns r6
small_loop_r6:
	ld.b	0[r7],r12
	add	1,r7
	st.b	r12,0[r6]
	add	1,r6
#ifdef __CORE_V850E3V5__
	loop 	r11, small_loop_r6
#else
	add	-1, r11
	bnz	small_loop_r6
#endif
	-- now check if r7 is aligned
	mov	r9, r8
	xor	r7,r11
	andi	3,r11,r11
	bz	both_aligned

bytesr7:
	-- r7 is not aligned, but if we get here r6 is aligned
	-- try copying to r6 four bytes at a time
	mov	r8,r9
	shr	2,r9
	bz	bytes	-- not enough bytes
.align 4
word_loop_r7:
#ifdef __CORE_V850E__
	ld.bu	0[r7], r10
	ld.bu	1[r7], r11
	ld.bu	2[r7], r12
	ld.bu	3[r7], r13
#else 
	-- Original V850
	ld.b	0[r7], r10
	ld.b	1[r7], r11
	ld.b	2[r7], r12
	ld.b	3[r7], r13
#endif
#ifdef __CORE_V850E3V5__
	bins	r11, 8, 8, r10
	bins	r12, 16, 8, r10
	bins	r13, 24, 8, r10
#else
#ifndef __CORE_V850E__
	-- Original V850
	andi	255,r10,r10
	andi	255,r11,r11
	andi	255,r12,r12
	andi	255,r13,r13
#endif
	shl	8,r11
	shl	16,r12
	shl	24,r13
	or	r11,r10
	or	r12,r10
	or	r13,r10
#endif
	add	4,r7
	st.w	r10,0[r6]
	add	4,r6
#ifdef __CORE_V850E3V5__
	loop 	r9, word_loop_r7
#else
	add	-1, r9
	bnz	word_loop_r7
#endif
	-- determine how many bytes are left to copy
	and	3,r8
	bnz	bytes
	mov	r1,r10
	jmp 	[lp]
-- Byte copy
bytes:
	cmp	zero,r8
	bz	end
.align 4
byte_loop:
	ld.b	0[r7],r11
	add	1,r7
	st.b	r11,0[r6]
	add	1,r6
#ifdef __CORE_V850E3V5__
	loop	r8, byte_loop
#else
	add	-1,r8
	bnz	byte_loop
#endif
end:
	mov 	r1,r10
	jmp	[lp]
#if __ghs_asm == 2
	.frameinfo _memcpy,0,0,0
#else
	.fsize _memcpy,0
#endif
	.scall _memcpy,__leaf__
	.type _memcpy,@function
	.size _memcpy,.-_memcpy

	.global ___mcopy
..lxtdaG.___mcopy=:0
	-- Must preserve all registers (except lp obviously)
	-- r1, r6-r14 are used by memcpy
	-- The arguments are the same as memcpy except the source and dest are
	-- reversed, which we must preserve unfortuantely for backwards
	-- compatibility
___callee.__mcopy.p.ppi::
	.size	___callee.__mcopy.p.ppi,0
___mcopy:
#ifdef __CORE_V850E3V5__
	pushsp	lp
	pushsp	r1
	pushsp	r6-r14
#else
	add	-44,sp
	st.w	r1, 0[sp]
	st.w	r6, 4[sp]
	st.w	r7, 8[sp]
	st.w	r8, 12[sp]
	st.w	r9, 16[sp]
	st.w	r10, 20[sp]
	st.w	r11, 24[sp]
	st.w	r12, 28[sp]
	st.w	r13, 32[sp]
	st.w	r14, 36[sp]
	st.w	lp, 40[sp]
#endif
	mov	r6, r9
	mov	r7, r6
	mov	r9, r7
	jarl	_memcpy_mcopy, lp
#ifdef __CORE_V850E3V5__
	popsp	r6-r14
	popsp	r1
	popsp	lp
#else
	ld.w	40[sp], lp 
	ld.w	0[sp], r1 
	ld.w	4[sp], r6 
	ld.w	8[sp], r7 
	ld.w	12[sp], r8 
	ld.w	16[sp], r9 
	ld.w	20[sp], r10
	ld.w	24[sp], r11
	ld.w	28[sp], r12
	ld.w	32[sp], r13
	ld.w	36[sp], r14
	add	44,sp
#endif
	jmp	[lp]
#if __ghs_asm == 2
	.frameinfo ___mcopy,44,40,0x80007fc2
#else
	.fsize 44
#endif
	.scall 	_memcpy_mcopy
	.type	___mcopy,@function
	.size	___mcopy,.-___mcopy
