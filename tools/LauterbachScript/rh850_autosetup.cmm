  )
  RETURN
; End of GetFlashConfigU2B
; --------------------------------------------------------------------------------

; --------------------------------------------------------------------------------
; --------------------------------------------------------------------------------
; Get FLASH configuration for RH850/U2C family:
; --------------------------------------------------------------------------------
GetFlashConfigU2C:

; define some macros
  LOCAL &RamBase &RamEnd &FlashCodeBase
  LOCAL &flashbinary &cpu_subfamily

  MAP.NoDenyAccess

  &cpu_subfamily=CPU.SUBFAMILY()
  IF (STRing.SCAN("&cpu_subfamily","RH850/U2C",0)==0)
  (
    FLASH.RESet
    IF ("&progtype"=="TARGET") ; ----------- SelfProgramming ------------------------------
    (
      IF (STRing.SCAN("&cpu_subfamily","RH850/U2C2",0)==0)
      (
        FLASH.Create 1. C:0x00000000--0x0001FFFF 0x00004000 TARGET Long /INFO "User Area 0"
        FLASH.Create 1. C:0x00020000--0x000FFFFF 0x00010000 TARGET Long /INFO "User Area 0"
        FLASH.Create 1. C:0x00400000--0x0041FFFF 0x00004000 TARGET Long /INFO "User Area 1"
        FLASH.Create 1. C:0x00420000--0x004FFFFF 0x00010000 TARGET Long /INFO "User Area 1"

        FLASH.Create 3. C:0x08000000--0x0800FFFF 0x00010000 NOP    Long /INFO "User Boot Area 0"
        FLASH.Create 3. C:0x08400000--0x0840FFFF 0x00010000 NOP    Long /INFO "User Boot Area 1"

        FLASH.Create 2. C:0xFF200000--0xFF21FFFF 0x00001000 TARGET Long /INFO "Data Area 0"
        FLASH.Create 2. C:0xFF280000--0xFF28FFFF 0x00001000 TARGET Long /INFO "Data Area 2"
        FLASH.Create 2. C:0xFF320000--0xFF3207FF 0x00000800 TARGET Long /INFO "Extended Data Area"
      )
      ELSE IF (STRing.SCAN("&cpu_subfamily","RH850/U2C4",0)==0)
      (
        FLASH.Create 1. C:0x00000000--0x0001FFFF 0x00004000 TARGET Long /INFO "User Area 0"
        FLASH.Create 1. C:0x00020000--0x001FFFFF 0x00010000 TARGET Long /INFO "User Area 0"
        FLASH.Create 1. C:0x00400000--0x0041FFFF 0x00004000 TARGET Long /INFO "User Area 1"
        FLASH.Create 1. C:0x00420000--0x005FFFFF 0x00010000 TARGET Long /INFO "User Area 1"

        FLASH.Create 3. C:0x08000000--0x0800FFFF 0x00010000 NOP    Long /INFO "User Boot Area 0"
        FLASH.Create 3. C:0x08400000--0x0840FFFF 0x00010000 NOP    Long /INFO "User Boot Area 1"

        FLASH.Create 2. C:0xFF200000--0xFF23FFFF 0x00001000 TARGET Long /INFO "Data Area 0"
        FLASH.Create 2. C:0xFF280000--0xFF28FFFF 0x00001000 TARGET Long /INFO "Data Area 2"
        FLASH.Create 2. C:0xFF320000--0xFF3207FF 0x00000800 TARGET Long /INFO "Extended Data Area"
      )
      ELSE // RH850/U2C8 or RH850/U2C8_EVA
      (
        FLASH.Create 1. C:0x00000000--0x0001FFFF 0x00004000 TARGET Long /INFO "User Area 0"
        FLASH.Create 1. C:0x00020000--0x003FFFFF 0x00010000 TARGET Long /INFO "User Area 0"
        FLASH.Create 1. C:0x00400000--0x0041FFFF 0x00004000 TARGET Long /INFO "User Area 1"
        FLASH.Create 1. C:0x00420000--0x007FFFFF 0x00010000 TARGET Long /INFO "User Area 1"

        FLASH.Create 3. C:0x08000000--0x0800FFFF 0x00010000 NOP    Long /INFO "User Boot Area 0"
        FLASH.Create 3. C:0x08400000--0x0840FFFF 0x00010000 NOP    Long /INFO "User Boot Area 1"

        FLASH.Create 2. C:0xFF200000--0xFF23FFFF 0x00001000 TARGET Long /INFO "Data Area 0"
        FLASH.Create 2. C:0xFF240000--0xFF25FFFF 0x00001000 TARGET Long /INFO "Data Area 1"
        FLASH.Create 2. C:0xFF280000--0xFF28FFFF 0x00001000 TARGET Long /INFO "Data Area 2"
        FLASH.Create 2. C:0xFF320000--0xFF3207FF 0x00000800 TARGET Long /INFO "Extended Data Area"
      )

      ; build FLASH.TARGET command ----------------------------------------
      &flashbinary=CPUFLASHTYPE()  ; get name of flashbinary for the selected CPU
      
      IF ("&flashbinary"=="UNDEF")
      (
        PRINT %ERROR "TRACE32 has no flash binary defined for the selected CPU --> script terminated"
        AREA.view
        GOTO EndERROR_NOFLASHBINARY
      )

      // get Local-Ram area
      &RamBase=0xfdc00000
      &RamEnd=0xfdc0ffff

      Data.Set &RamBase--&RamEnd %Long 0x0   ; init RAM to prevent ECC errors

      &FlashCodeBase=&RamBase+0x2000

      FLASH.TARGET &FlashCodeBase &RamBase 0x1000 ~~/demo/rh850/flash/long/&flashbinary /DualPort /STACKSIZE 0x200 /CORE 0
    )
    ELSE ; ----------- SerialFlashProgramming ----------------------------
    (
      IF (STRing.SCAN("&cpu_subfamily","RH850/U2C2",0)==0)
      (
        FLASH.Create 1. C:0x00000000--0x0001FFFF 0x00004000 RH850 Long /INFO "User Area 0"
        FLASH.Create 1. C:0x00020000--0x000FFFFF 0x00010000 RH850 Long /INFO "User Area 0"
        FLASH.Create 1. C:0x00400000--0x0041FFFF 0x00004000 RH850 Long /INFO "User Area 1"
        FLASH.Create 1. C:0x00420000--0x004FFFFF 0x00010000 RH850 Long /INFO "User Area 1"

        FLASH.Create 3. C:0x08000000--0x0800FFFF 0x00010000 RH850 Long /INFO "User Boot Area 0"
        FLASH.Create 3. C:0x08400000--0x0840FFFF 0x00010000 RH850 Long /INFO "User Boot Area 1"

        FLASH.Create 2. C:0xFF200000--0xFF21FFFF 0x00001000 RH850 Long /INFO "Data Area 0"
        FLASH.Create 2. C:0xFF280000--0xFF28FFFF 0x00001000 RH850 Long /INFO "Data Area 2"
        FLASH.Create 2. C:0xFF320000--0xFF3207FF 0x00000800 RH850 Long /INFO "Extended Data Area"
      )
      ELSE IF (STRing.SCAN("&cpu_subfamily","RH850/U2C4",0)==0)
      (
        FLASH.Create 1. C:0x00000000--0x0001FFFF 0x00004000 RH850 Long /INFO "User Area 0"
        FLASH.Create 1. C:0x00020000--0x001FFFFF 0x00010000 RH850 Long /INFO "User Area 0"
        FLASH.Create 1. C:0x00400000--0x0041FFFF 0x00004000 RH850 Long /INFO "User Area 1"
        FLASH.Create 1. C:0x00420000--0x005FFFFF 0x00010000 RH850 Long /INFO "User Area 1"

        FLASH.Create 3. C:0x08000000--0x0800FFFF 0x00010000 RH850 Long /INFO "User Boot Area 0"
        FLASH.Create 3. C:0x08400000--0x0840FFFF 0x00010000 RH850 Long /INFO "User Boot Area 1"

        FLASH.Create 2. C:0xFF200000--0xFF23FFFF 0x00001000 RH850 Long /INFO "Data Area 0"
        FLASH.Create 2. C:0xFF280000--0xFF28FFFF 0x00001000 RH850 Long /INFO "Data Area 2"
        FLASH.Create 2. C:0xFF320000--0xFF3207FF 0x00000800 RH850 Long /INFO "Extended Data Area"
      )
      ELSE // RH850/U2C8 or RH850/U2C8_EVA
      (
        FLASH.Create 1. C:0x00000000--0x0001FFFF 0x00004000 RH850 Long /INFO "User Area 0"
        FLASH.Create 1. C:0x00020000--0x003FFFFF 0x00010000 RH850 Long /INFO "User Area 0"
        FLASH.Create 1. C:0x00400000--0x0041FFFF 0x00004000 RH850 Long /INFO "User Area 1"
        FLASH.Create 1. C:0x00420000--0x007FFFFF 0x00010000 RH850 Long /INFO "User Area 1"

        FLASH.Create 3. C:0x08000000--0x0800FFFF 0x00010000 RH850 Long /INFO "User Boot Area 0"
        FLASH.Create 3. C:0x08400000--0x0840FFFF 0x00010000 RH850 Long /INFO "User Boot Area 1"

        FLASH.Create 2. C:0xFF200000--0xFF23FFFF 0x00001000 RH850 Long /INFO "Data Area 0"
        FLASH.Create 2. C:0xFF240000--0xFF25FFFF 0x00001000 RH850 Long /INFO "Data Area 1"
        FLASH.Create 2. C:0xFF280000--0xFF28FFFF 0x00001000 RH850 Long /INFO "Data Area 2"
        FLASH.Create 2. C:0xFF320000--0xFF3207FF 0x00000800 RH850 Long /INFO "Extended Data Area"
      )
    )
  )
  RETURN
; End of GetFlashConfigU2C
; --------------------------------------------------------------------------------
